# ============================================================================
# KMS Docker Development Environment
# ============================================================================
# For use with docker-compose-local.yml
# Usage: copy this to .env when running with Docker
#   copy .env.docker .env
# ============================================================================

# ==================== Application ====================
APP_ENV=development
DEBUG=true
APP_NAME="KMS API (Docker)"
APP_VERSION="1.0.0"

# ==================== Server ====================
HOST=0.0.0.0
PORT=9000
WORKERS=4

# ==================== Security Keys ====================
# IMPORTANT: Generate your own keys for production!
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your_jwt_secret_key_min_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_MASTER_KEY=your_encryption_master_key_min_32_chars
ENCRYPTION_SALT=your_encryption_salt_min_16_chars

# ==================== Neo4j Graph Database (DOCKER) ====================
# Container name: neo4j-graphrag
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphrag2024

# ==================== PostgreSQL Database (DOCKER) ====================
# Container name: postgres-kms
POSTGRES_HOST=postgres-kms
POSTGRES_PORT=5432
POSTGRES_DB=ragdb
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpassword123
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10

# ==================== Admin User ====================
ADMIN_INITIAL_PASSWORD=SecureAdm1nP@ss!
ADMIN_ID=admin
ADMIN_EMAIL=admin@localhost

# ==================== Corporate SSO ====================
CORP_EMAIL_DOMAINS=tmaxsoft.com,tmax.co.kr,tmaxsoft.co.jp,gmail.com

# ==================== LLM Configuration (DOCKER GPU) ====================
# Nemotron LLM - Container: nemotron-local
LLM_API_URL=http://nemotron-llm:8000/v1/chat/completions
LLM_MODEL=nvidia/nvidia-nemotron-nano-9b-v2

# Code LLM - Container: mistral-coder-local
CODE_LLM_API_URL=http://mistral-nemo-coder:8000/v1/chat/completions
CODE_LLM_MODEL=mistralai/Mistral-Nemo-Instruct-2407
CODE_LLM_TEMPERATURE=0.1
CODE_LLM_MAX_TOKENS=2048

# RAG LLM Context Mode
RAG_LLM_USE_LARGE_CONTEXT=false

# ==================== Embedding Configuration (DOCKER GPU) ====================
# NeMo Embedding - Container: nemo-embedding-local
EMBEDDING_API_URL=http://nemo-embedding:8000/v1
EMBEDDING_MODEL=nvidia/nv-embedqa-mistral-7b-v2
EMBEDDING_DIMENSION=4096
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_TOKENS=512
EMBEDDING_SAFE_TOKEN_LIMIT=380

# ==================== Ollama (DOCKER) ====================
# Container: ollama-local or ollama-gpu
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b

# ==================== Vision LLM (DOCKER GPU) ====================
VISION_API_URL=http://vision-llm:8000/v1/chat/completions
VISION_LLM_MODEL=nvidia/llama-3.1-nemotron-nano-vl-8b-v1

# ==================== Vector & RAG ====================
VECTOR_INDEX_NAME=chunk_embedding
VECTOR_SIMILARITY_FUNCTION=cosine
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
DEFAULT_RAG_STRATEGY=auto
VECTOR_WEIGHT=0.5
TOP_K_RESULTS=5

# ==================== File Upload & Rate Limiting ====================
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./uploads
RATE_LIMIT_QUERY=60
RATE_LIMIT_UPLOAD=10
RATE_LIMIT_DEFAULT=120

# ==================== LLM Context Length ====================
LLM_MAX_CONTEXT_LENGTH=2000
LLM_MAX_TOKENS=1024

# ==================== Deep Agent ====================
ENABLE_DEEP_AGENT=false

# ==================== VLM Settings ====================
VLM_CACHE_MAX_SIZE=1000
VLM_CACHE_TTL=3600
VLM_MAX_CONCURRENT=3
VLM_BATCH_SIZE=4

# ==================== CLIP Settings ====================
CLIP_MODEL=clip-ViT-B-32
CLIP_MAX_IMAGE_SIZE=1024
CLIP_BATCH_SIZE=8

# ==================== Image/Multimodal ====================
IMAGE_MODEL=bakllava
IMAGE_EMBEDDING_DIMENSION=4096
MULTIMODAL_MODEL=bakllava
MULTIMODAL_EMBEDDING_DIMENSION=4096
MULTIMODAL_CHUNK_SIZE=500
MULTIMODAL_CHUNK_OVERLAP=100

# ==================== Ollama Fallback ====================
DISABLE_OLLAMA_FALLBACK=false

# ==================== Cross-Encoder Re-ranker ====================
ENABLE_CROSS_ENCODER_RERANKER=true

# ==================== VLM Table Extraction ====================
ENABLE_VLM_TABLE_EXTRACTION=true

# ==================== External Connectors ====================
# Copy values from .env.local or configure your own OAuth credentials
NOTION_CLIENT_ID=your_notion_client_id
NOTION_CLIENT_SECRET=your_notion_client_secret
ATLASSIAN_CLIENT_ID=your_atlassian_client_id
ATLASSIAN_CLIENT_SECRET=your_atlassian_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GOOGLE_DRIVE_CLIENT_ID=your_google_drive_client_id
GOOGLE_DRIVE_CLIENT_SECRET=your_google_drive_client_secret
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret

# ==================== RAG Evaluation ====================
RAG_EVALUATION_AUTO_EVALUATE=true

# ==================== Learning LLM ====================
ENABLE_LEARNING_LLM=false
LEARNING_LLM_AUTO_LOAD=false

# ==================== Code LLM Ollama Fallback ====================
CODE_LLM_USE_OLLAMA_FALLBACK=true
CODE_LLM_OLLAMA_MODEL=qwen2.5-coder:3b
